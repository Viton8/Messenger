DEBUG=True
SECRET_KEY=SUPERSECRETDJANGOSECRETKEYTOENCRYPTYOURSECRETDATA
ALLOWED_HOSTS=localhost,127.0.0.1

POSTGRES_DB=messenger
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_HOST=db
POSTGRES_PORT=5432
PGADMIN_DEFAULT_EMAIL=admin@example.com
PGADMIN_DEFAULT_PASSWORD=admin

# Keep True in production. False skips the confirmation email so a local
# tester can sign in immediately. The server refuses to start if this is
# False while DEBUG is False.
ACCOUNT_EMAIL_CONFIRMATION_REQUIRED=True

# Account email requests per IP and per address. Window is in seconds.
ACCOUNT_EMAIL_RATE_LIMIT=5
ACCOUNT_EMAIL_RATE_WINDOW=3600
GROUP_MAX_MEMBERS=50
GROUP_MEMBER_RATE_LIMIT=20
GROUP_MEMBER_RATE_WINDOW=3600
BOARDS_MAX_PER_GROUP=20
BOARDS_MAX_LIVE_OBJECTS=2000
BOARDS_MAX_MESSAGE_BYTES=262144
BOARDS_OPS_PER_SECOND=30
BOARDS_TRANSIENT_PER_SECOND=20
BOARDS_MAX_OPS_PER_MESSAGE=100
REDIS_URL=redis://redis:6379/1

# Mail. The default backend prints messages in the web container logs.
# Set EMAIL_BACKEND to django.core.mail.backends.smtp.EmailBackend and
# fill EMAIL_HOST to send real mail.
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
DEFAULT_FROM_EMAIL=noreply@messenger.local
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
